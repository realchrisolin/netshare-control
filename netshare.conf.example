# Optional. Copy to /etc/netshare.conf and keep it owned by root.
# The script refuses to source a config that is not root-owned.
# Leave these unset to discover a NetShare access point by its gateway proxy.
# The SSID is not a setting. Do not put a live interface name here.

# PROXY_PORT="8282"
# PROXY_URL stays an HTTP URL. The tun uses SOCKS5 on that same host and port.
# PROXY_URL=""
# BYPASS_CIDR=""
# IFACE=""

# Only `netshare bar` uses this. Empty lists every link the probe accepted.
# A non-empty value is a NetworkManager connection-name prefix.
# CONNECTION_PREFIX=""

# Account whose traffic `up` and `default on` send through the tun.
# Overrides sudo. Empty, and no sudo user, leaves the tun for `netshare run`.
# Use a numeric uid. Do not put a name or a host-specific id in this example.
# NETSHARE_UID=""

# Concurrent tun2proxy sessions. The binary's own default is 200.
# MAX_SESSIONS="1024"
