#!/usr/bin/env bash
# Console controller for a NetShare tun. Discovery uses the HTTP proxy.
# tun2proxy uses SOCKS5 on that same port. `netshare bar` is the optional
# panel readout and does not change routes.

set -euo pipefail
HERE=$(dirname "$(readlink -f "$0")")
# shellcheck source=lib/tunnel.sh
source "$HERE/lib/tunnel.sh"

if [[ "${1:-}" == "--inside-run" ]]; then
  inside_run "$@"
  exit $?
fi

# Re-apply the session proxy onto an already-running desktop tunnel.
# `up` returns before this when the tun is already up.
if [[ "${NETSHARE_APPLY_ONLY:-}" == "proxy" ]]; then
  [[ "$(id -u)" -eq 0 ]] || die "proxy apply requires root"
  load_state || die "no tunnel state"
  [[ "$posture" == "desktop" ]] || die "desktop rule is not installed"
  BYPASS_CIDR=$state_bypass
  gateway=$state_gateway
  [[ -n "$desktop_uid" && -n "$gateway" && -n "$BYPASS_CIDR" ]] || die "state is missing the desktop proxy fields"
  apply_session_proxy
  exit $?
fi

case "${1:-}" in
  -h|--help|help)
    usage
    exit 0
    ;;
  "")
    usage >&2
    exit 2
    ;;
  up)
    cmd_up
    ;;
  down)
    cmd_down
    ;;
  status)
    cmd_status
    ;;
  bar)
    # shellcheck source=lib/bar.sh
    source "$HERE/lib/bar.sh"
    cmd_bar
    ;;
  toggle)
    cmd_toggle
    ;;
  default)
    shift
    cmd_default "$@"
    ;;
  run)
    shift
    cmd_run "$@"
    ;;
  dns-reassert)
    cmd_dns_reassert
    ;;
  transport-down)
    shift
    cmd_transport_down "$@"
    ;;
  reap)
    cmd_reap
    ;;
  *)
    die "unknown command: $1"
    ;;
esac
